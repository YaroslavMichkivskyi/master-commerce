{
  "name": "@master-commerce/service-core",
  "version": "0.1.0",
  "private": true,
  "description": "Base of every NestJS service (Microservice chassis pattern): config checks, logs, health, metrics, errors, OpenAPI, shutdown (ADR 0020)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@nestjs/common": "^12.4.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@nestjs/common": "12.4.2",
    "@swc/core": "1.16.22",
    "@types/node": "24.19.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typescript": "6.0.3",
    "unplugin-swc": "2.0.0",
    "vitest": "5.1.0"
  }
}
