# Local development settings. `pnpm dev` copies this file to `.env` when `.env` is missing.
# Values here are local-only defaults, never real credentials.

# --- PostgreSQL (one database per service) ---
POSTGRES_IDENTITY_PORT=55432
POSTGRES_CATALOG_PORT=55433
POSTGRES_ORDERS_PORT=55434

IDENTITY_DB_USER=identity
IDENTITY_DB_PASSWORD=identity_local
CATALOG_DB_USER=catalog
CATALOG_DB_PASSWORD=catalog_local
ORDERS_DB_USER=orders
ORDERS_DB_PASSWORD=orders_local

# --- RabbitMQ ---
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672
RABBITMQ_USER=shop
RABBITMQ_PASSWORD=shop_local

# --- Apps ---
WEB_PORT=3000
GATEWAY_PORT=3001
CATALOG_PORT=3002

CATALOG_DATABASE_URL=postgres://catalog:catalog_local@localhost:55433/catalog
CATALOG_SERVICE_URL=http://localhost:3002
GATEWAY_URL=http://localhost:3001
