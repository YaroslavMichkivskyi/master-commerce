{
  "name": "datagen",
  "version": "0.1.0",
  "private": true,
  "description": "Deterministic, skewed computer-hardware catalog for the catalog database: demos and load tests",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "pg": "8.23.1",
    "pg-copy-streams": "7.0.0"
  },
  "devDependencies": {
    "@types/node": "26.6.10",
    "@types/pg": "8.23.1",
    "@types/pg-copy-streams": "1.2.5",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
